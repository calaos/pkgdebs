#!/bin/bash
# Prepares the `calaos` meta package (calaos-meta/) for a Calaos OS release:
# its version is the Calaos OS version, its Depends pin every calaos-*
# component to the latest version published in the apt channel, and its
# changelog lists those versions (the release note).

set -euo pipefail

MAINTAINER="Calaos Team <team@calaos.fr>"
ARCHES=(all amd64 arm64)
STABLE_RE='^20[0-9]{2}\.(0[1-9]|1[0-2])(\.[1-9][0-9]*)?$'
DEV_RE='^20[0-9]{2}\.(0[1-9]|1[0-2])(\.[1-9][0-9]*)?~dev\.(0|[1-9][0-9]*)$'

declare -A LATEST=() HIGHEST=()
declare -a CALAOS_VERSIONS=()

die()
{
    echo "error: $*" >&2
    exit 1
}

usage()
{
    cat >&2 <<EOF
usage:
  $0 urls    <stable|dev> <calaos.list>
  $0 fetch   <stable|dev> <calaos.list> <index dir>
  $0 prepare <stable|dev> <version> <index dir> <package dir> [notes file]
  $0 next    <stable|dev> <YYYY.MM> [published calaos version...]

An empty <version> makes prepare compute it from the calaos versions of the
index and the current UTC month; next does the same from its arguments.
prepare prints version=<debian version> and tag_version=<git tag version>.
EOF
    exit 2
}

# A dev box sees both components, so a stable version newer than every
# pre-release must still win there.
components()
{
    case "$1" in
        stable) echo releases ;;
        dev) echo releases pre-releases ;;
        *) die "unknown channel '$1' (expected stable or dev)" ;;
    esac
}

cmd_urls()
{
    local channel=$1 list=$2 comps found=0 i url suite repo comp arch
    local -a f
    comps=$(components "$channel")
    [[ -r $list ]] || die "cannot read $list"
    while read -r -a f; do
        [[ ${f[0]:-} == deb ]] || continue
        i=1
        if [[ ${f[1]:-} == \[* ]]; then
            while ((i < ${#f[@]})) && [[ ${f[$i]} != *']' ]]; do
                i=$((i + 1))
            done
            i=$((i + 1))
        fi
        url=${f[$i]:-}
        suite=${f[$((i + 1))]:-}
        [[ -n $url && -n $suite ]] || die "malformed line in $list: ${f[*]}"
        url=${url%/}
        repo=${url##*/}
        for comp in $comps; do
            for arch in "${ARCHES[@]}"; do
                echo "$repo.$comp.$arch $url/dists/$suite/$comp/binary-$arch/Packages"
            done
        done
        found=1
    done <"$list"
    ((found)) || die "no deb line in $list"
}

cmd_fetch()
{
    local channel=$1 list=$2 dir=$3 name url
    mkdir -p "$dir"
    cmd_urls "$channel" "$list" | while read -r name url; do
        echo "fetching $url" >&2
        curl -fsSL --retry 3 -o "$dir/$name" "$url"
    done
}

# Calaos OS versions are calendar based: YYYY.MM, YYYY.MM.N for a second
# release in the same month, YYYY.MM~dev.M or YYYY.MM.N~dev.M for a
# pre-release. The git tag form -dev.M is accepted too.
normalize_version()
{
    local channel=$1 version=${2/-dev./\~dev.}
    case "$channel" in
        stable) [[ $version =~ $STABLE_RE ]] ||
            die "'$2' is not a stable Calaos OS version (YYYY.MM or YYYY.MM.N, N >= 1)" ;;
        dev) [[ $version =~ $DEV_RE ]] ||
            die "'$2' is not a dev Calaos OS version (YYYY.MM~dev.M or YYYY.MM.N~dev.M)" ;;
        *) die "unknown channel '$channel' (expected stable or dev)" ;;
    esac
    VERSION=$version
}

# Pure: the next Calaos OS version of a month (YYYY.MM) given the published
# calaos versions. Stable: YYYY.MM, then YYYY.MM.N with N above the highest of
# the month. Dev: the stable that would be computed, then ~dev.M with M above
# the highest pre-release of that base, from 1.
next_version()
{
    local channel=$1 month=$2 v n max=-1 base dmax=0 m
    shift 2
    [[ $month =~ ^20[0-9]{2}\.(0[1-9]|1[0-2])$ ]] || die "'$month' is not a month (YYYY.MM)"
    for v in "$@"; do
        if [[ $v =~ $STABLE_RE && $v == "$month"* ]]; then
            n=${v#"$month"}
            n=${n#.}
            n=${n:-0}
            ((n > max)) && max=$n
        fi
    done
    if ((max < 0)); then base=$month; else base=$month.$((max + 1)); fi
    case "$channel" in
        stable) echo "$base" ;;
        dev)
            for v in "$@"; do
                if [[ $v =~ $DEV_RE && $v == "$base~dev."* ]]; then
                    m=${v##*.}
                    ((m > dmax)) && dmax=$m
                fi
            done
            echo "$base~dev.$((dmax + 1))"
            ;;
        *) die "unknown channel '$channel' (expected stable or dev)" ;;
    esac
}

# Index files are named <repo>.<component>.<arch> (cmd_urls). Only the
# components of the channel are read: a directory filled by a dev fetch must
# not make a stable release depend on pre-releases.
# LATEST is the lowest of the per-arch highest versions, so that the pin can
# be met on every arch that publishes the package; HIGHEST is the overall max.
load_latest()
{
    local channel=$1 dir=$2 comps name pkg ver arch key f
    local -a files=()
    local -A per_arch=()
    comps=" $(components "$channel") "
    for f in "$dir"/*; do
        [[ -f $f ]] || continue
        name=${f##*/}
        name=${name%.*}
        [[ $comps == *" ${name##*.} "* ]] && files+=("$f")
    done
    ((${#files[@]})) || die "no apt index of the $channel channel in $dir"
    while read -r arch pkg ver; do
        key="$pkg $arch"
        if [[ -z ${per_arch[$key]:-} ]] || dpkg --compare-versions "$ver" gt "${per_arch[$key]}"; then
            per_arch[$key]=$ver
        fi
    done < <(awk '
        function flush() { if (p != "" && v != "") print a, p, v; p = v = "" }
        FNR == 1 { flush(); a = FILENAME; sub(/.*\./, "", a) }
        /^Package:/ { p = $2 }
        /^Version:/ { v = $2 }
        /^[ \t]*$/ { flush() }
        END { flush() }
    ' "${files[@]}" | awk '$2 == "calaos" || $2 ~ /^calaos-/')
    for key in "${!per_arch[@]}"; do
        pkg=${key% *}
        ver=${per_arch[$key]}
        [[ $pkg == calaos ]] && CALAOS_VERSIONS+=("$ver")
        if [[ -z ${LATEST[$pkg]:-} ]] || dpkg --compare-versions "$ver" lt "${LATEST[$pkg]}"; then
            LATEST[$pkg]=$ver
        fi
        if [[ -z ${HIGHEST[$pkg]:-} ]] || dpkg --compare-versions "$ver" gt "${HIGHEST[$pkg]}"; then
            HIGHEST[$pkg]=$ver
        fi
    done
}

control_depends()
{
    awk '
        /^Depends:/ { d = 1; sub(/^Depends:/, ""); print; next }
        d && /^[ \t]/ { print; next }
        { d = 0 }
    ' "$1" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$'
}

cmd_prepare()
{
    local channel=$1 version_in=$2 index=$3 pkgdir=$4 notes=${5:-}
    local control=$pkgdir/debian/control changelog=$pkgdir/debian/changelog
    local published source entry deps="" date ver
    local -a entries=() pinned=() missing=()

    [[ -f $control ]] || die "no $control"
    [[ -d $index ]] || die "no index directory $index"
    load_latest "$channel" "$index"
    if [[ -z $version_in ]]; then
        version_in=$(next_version "$channel" "${CALAOS_OS_RELEASE_MONTH:-$(date -u +%Y.%m)}" "${CALAOS_VERSIONS[@]}")
        echo "computed version $version_in" >&2
    fi
    normalize_version "$channel" "$version_in"

    published=${HIGHEST[calaos]:-}
    if [[ -n $published ]] && ! dpkg --compare-versions "$VERSION" gt "$published"; then
        die "$VERSION is not greater than the published calaos $published"
    fi

    mapfile -t entries < <(control_depends "$control")
    ((${#entries[@]})) || die "no Depends in $control"
    for entry in "${entries[@]}"; do
        if [[ $entry =~ ^calaos-[a-z0-9.+-]+$ ]]; then
            ver=${LATEST[$entry]:-}
            if [[ -z $ver ]]; then
                missing+=("$entry")
                continue
            fi
            pinned+=("$entry $ver")
            entry="$entry (>= $ver)"
        elif [[ $entry == calaos-* ]]; then
            die "Depends entry '$entry' already has a constraint: leave calaos-* entries bare"
        fi
        deps+="${deps:+,$'\n'         }$entry"
    done
    ((${#missing[@]} == 0)) || die "not published in the $channel channel: ${missing[*]}"

    DEPS=$deps awk '
        /^Depends:/ { print "Depends: " ENVIRON["DEPS"]; skip = 1; next }
        skip && /^[ \t]/ { next }
        { skip = 0; print }
    ' "$control" >"$control.new"
    mv "$control.new" "$control"

    source=$(awk '/^Source:/ { print $2; exit }' "$control")
    date=${CALAOS_OS_RELEASE_DATE:-$(date -R)}
    {
        echo "$source ($VERSION) bookworm; urgency=medium"
        echo
        echo "  * Calaos OS $VERSION ($channel)."
        for entry in "${pinned[@]}"; do
            echo "  * $entry"
        done
        echo
        echo " -- $MAINTAINER  $date"
    } >"$changelog"

    if [[ -n $notes ]]; then
        {
            echo "Calaos OS $VERSION ($channel)"
            echo
            for entry in "${pinned[@]}"; do
                echo "- $entry"
            done
        } >"$notes"
    fi

    echo "version=$VERSION"
    echo "tag_version=${VERSION//\~/-}"
}

(($# >= 1)) || usage
cmd=$1
shift
case "$cmd" in
    urls) (($# == 2)) || usage; cmd_urls "$@" ;;
    fetch) (($# == 3)) || usage; cmd_fetch "$@" ;;
    next) (($# >= 2)) || usage; next_version "$@" ;;
    prepare) (($# == 4 || $# == 5)) || usage; cmd_prepare "$@" ;;
    *) usage ;;
esac
