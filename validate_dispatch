#!/bin/bash
# Gate for the build_deb workflows: their inputs come from a dispatch payload
# and reach make and sed, so nothing outside these patterns may get through.
# usage: validate_dispatch [--image-required] <pkgname> <version> [image_src]
# --image-required: a package that has an image needs an explicit image_src
# (manual runs: the Makefile default may name an image that does not exist).

# Byte-wise ranges: no locale may widen [a-z] or [0-9].
export LC_ALL=C

ROOT=$(cd "$(dirname "$0")" && pwd)
PKGNAME_RE='^[a-z0-9][a-z0-9-]*$'
# 4.8.3, 2.0.22.1, 4.8.2-dev.3 (a dev tag; build_deb turns the first - into ~)
VERSION_RE='^[0-9]+(\.[0-9]+){0,3}([-~]dev\.[0-9]+)?$'
# Only the tag of an image may vary: ghcr.io/calaos/calaos_base:4.8.3-rc1
TAG_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
TAG_MAX=128

refuse()
{
    echo "::error::$1"
    exit 1
}

require_image=0
if [ "${1:-}" = --image-required ]; then
    require_image=1
    shift
fi

[ $# -ge 2 ] && [ $# -le 3 ] || refuse "usage: validate_dispatch [--image-required] <pkgname> <version> [image_src]"

pkgname=$1 version=$2 image_src=${3:-}

[[ $pkgname =~ $PKGNAME_RE ]] || refuse "package name is not [a-z0-9-]+"
# After the pattern: no case or whitespace variant of the name gets past it.
[ "$pkgname" != calaos-meta ] ||
    refuse "calaos-meta is published by the Release Calaos OS workflow only"
[ -f "$ROOT/$pkgname/debian/control" ] || refuse "$pkgname is not a package of this repository"
[[ $version =~ $VERSION_RE ]] ||
    refuse "version is not like 4.8.3, 4.8.2-dev.3 or 2.0.22.1 (a revision is X.Y.Z.N, not X.Y.Z-N)"

default=$(sed -n 's/^IMAGE_SRC?=//p' "$ROOT/$pkgname/Makefile")
if [ -z "$image_src" ] && [ "$require_image" = 1 ] && [ -n "$default" ]; then
    refuse "$pkgname needs an explicit image_src"
fi
if [ -n "$image_src" ]; then
    # The image repository is the one the package Makefile pulls by default.
    [ -n "$default" ] || refuse "$pkgname takes no image source"
    # Drop only the last :tag; a registry may carry a port.
    repo=${default%:*}
    [[ $image_src == "$repo":* ]] && [[ ${image_src#"$repo":} =~ $TAG_RE ]] &&
        [ "${#image_src}" -le $((${#repo} + 1 + TAG_MAX)) ] ||
        refuse "image source is not $repo:<tag>"
fi
exit 0
