#!/bin/sh
# postinst script for calaos-keyring

set -e

case "$1" in
    configure)
        # Clean up old GPG key location (was manually installed in trusted.gpg.d)
        # Key is now scoped to calaos repos only via /usr/share/keyrings/
        if [ -f /etc/apt/trusted.gpg.d/calaos.gpg ]; then
            rm -f /etc/apt/trusted.gpg.d/calaos.gpg
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
