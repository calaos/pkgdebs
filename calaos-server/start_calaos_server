#!/bin/bash

set -e

cidfile=$1
[ -z "$cidfile" ] && {
    echo "Missing arg"
    exit 1
}

# /dev/bus/usb only exists once a USB controller is present; podman fails
# with "statfs" on a missing bind source, so the mount must be conditional.
usb_opts=()
[ -d /dev/bus/usb ] && usb_opts=(-v /dev/bus/usb:/dev/bus/usb)

# The daemon owns this directory (root, 0700) and creates it itself; only the
# console subdirectory is shared, /run/calaos-container also holds the admin
# sessions. It must exist before podman runs since calaos-server can start
# first, and the daemon never replaces it, so the mount stays valid.
install -d -m 0700 -o root -g root /run/calaos-container /run/calaos-container/console

exec podman run \
        --name=calaos-server \
        --cidfile="${cidfile}" --replace --rm --cgroups=split --tz=local \
        --sdnotify=conmon -d \
        -v /mnt/calaos/cache:/root/.cache/calaos/ \
        -v /mnt/calaos/config:/root/.config/calaos \
        -v /usr/share/calaos/remote-ui/firmwares:/opt/share/calaos/firmwares:ro \
        -v /usr/share/calaos/webapp:/opt/share/calaos/app:ro \
        -v /run/calaos:/run/calaos \
        -v /run/calaos-container/console:/run/calaos-container/console \
        --privileged "${usb_opts[@]}" \
        --network=host \
        --pull=never \
        --replace \
        --tz=local \
        "${IMAGE_SRC}" \
        /opt/bin/calaos_server
